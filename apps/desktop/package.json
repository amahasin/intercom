{
  "name": "@officemesh/desktop",
  "private": true,
  "version": "0.1.0",
  "productName": "OfficeMesh",
  "description": "OfficeMesh desktop app",
  "author": "OfficeMesh",
  "main": "dist/main/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p preload/tsconfig.json && tsc --noEmit -p renderer/tsconfig.json",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron . --profile=dev",
    "dist": "electron-builder --config electron-builder.yml --win --x64 && electron-builder --config electron-builder.yml --win --arm64"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.343",
    "@lexical/react": "0.52.0",
    "@officemesh/core": "workspace:*",
    "@officemesh/protocol": "workspace:*",
    "@tanstack/react-virtual": "3.14.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "lexical": "0.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.2",
    "yjs": "13.6.33",
    "zustand": "5.0.15"
  }
}
